<robot name="simple_quad_with_payload_gripper">

  <!-- Materials -->
  <material name="yellow"><color rgba="0.95 0.90 0.60 1.0"/></material>
  <material name="dark_blue"><color rgba="0.10 0.20 0.60 1.0"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="gray"><color rgba="0.60 0.60 0.60 1.0"/></material>

  <!-- =========================
       Base link (body)
       ========================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.05"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0"
               iyy="0.01" iyz="0.0"
               izz="0.02"/>
    </inertial>
  </link>

  <!-- =========================
       Rotors (4) - dark blue
       ========================= -->

  <!-- Rotor 0 (front) -->
  <link name="rotor_0">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.01"/></geometry>
      <material name="dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.01"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0.0" ixz="0.0"
               iyy="0.00002" iyz="0.0"
               izz="0.00004"/>
    </inertial>
  </link>

  <joint name="rotor_0_joint" type="continuous">
    <origin xyz="0.22 0.00 0.00" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rotor_0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Rotor 1 (right) -->
  <link name="rotor_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.01"/></geometry>
      <material name="dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.01"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0.0" ixz="0.0"
               iyy="0.00002" iyz="0.0"
               izz="0.00004"/>
    </inertial>
  </link>

  <joint name="rotor_1_joint" type="continuous">
    <origin xyz="0.00 0.22 0.00" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rotor_1"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Rotor 2 (back) -->
  <link name="rotor_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.01"/></geometry>
      <material name="dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.01"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0.0" ixz="0.0"
               iyy="0.00002" iyz="0.0"
               izz="0.00004"/>
    </inertial>
  </link>

  <joint name="rotor_2_joint" type="continuous">
    <origin xyz="-0.22 0.00 0.00" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rotor_2"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- Rotor 3 (left) -->
  <link name="rotor_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.01"/></geometry>
      <material name="dark_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.08" length="0.01"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00002" ixy="0.0" ixz="0.0"
               iyy="0.00002" iyz="0.0"
               izz="0.00004"/>
    </inertial>
  </link>

  <joint name="rotor_3_joint" type="continuous">
    <origin xyz="0.00 -0.22 0.00" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rotor_3"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- =========================
       Payload link under drone
       ========================= -->
  <link name="payload_link">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.30"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.015" length="0.30"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.15" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.002" iyz="0"
               izz="0.0005"/>
    </inertial>
  </link>

  <joint name="payload_joint" type="fixed">
    <origin xyz="0 0 -0.025" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="payload_link"/>
  </joint>

  <!-- =========================
       Gripper: base + 2 finger joints
       Fingers are attached to gripper_base via revolute joints.
       ========================= -->

  <link name="gripper_base">
    <visual>
      <origin xyz="0 0 -0.30" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.03"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.30" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.03"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.30" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="2e-4" ixy="0" ixz="0"
               iyy="2e-4" iyz="0"
               izz="2e-4"/>
    </inertial>
  </link>

  <joint name="gripper_mount_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="payload_link"/>
    <child link="gripper_base"/>
  </joint>

  <!-- Left finger -->
  <link name="left_finger">
    <visual>
      <!-- finger geometry defined in its own frame; joint origin will place it -->
      <origin xyz="0.03 0.0 0.0" rpy="0 0 0"/>
      <geometry><box size="0.06 0.01 0.01"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.03 0.0 0.0" rpy="0 0 0"/>
      <geometry><box size="0.06 0.01 0.01"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.03 0.0 0.0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="2e-5" ixy="0" ixz="0"
               iyy="2e-5" iyz="0"
               izz="2e-5"/>
    </inertial>
  </link>

  <joint name="left_finger_joint" type="revolute">
    <!-- attach to gripper_base frame -->
    <origin xyz="0.0 0.015 -0.30" rpy="0 0 0"/>
    <parent link="gripper_base"/>
    <child link="left_finger"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.8" effort="1.0" velocity="2.0"/>
  </joint>

  <!-- Right finger -->
  <link name="right_finger">
    <visual>
      <origin xyz="0.03 0.0 0.0" rpy="0 0 0"/>
      <geometry><box size="0.06 0.01 0.01"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.03 0.0 0.0" rpy="0 0 0"/>
      <geometry><box size="0.06 0.01 0.01"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.03 0.0 0.0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="2e-5" ixy="0" ixz="0"
               iyy="2e-5" iyz="0"
               izz="2e-5"/>
    </inertial>
  </link>

  <joint name="right_finger_joint" type="revolute">
    <origin xyz="0.0 -0.015 -0.30" rpy="0 0 0"/>
    <parent link="gripper_base"/>
    <child link="right_finger"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.8" upper="0.0" effort="1.0" velocity="2.0"/>
  </joint>

</robot>

