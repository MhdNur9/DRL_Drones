<robot name="basket_robot">
  <link name="basket_link">
    <!-- Bottom (floor) of the basket -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.5 0.02"/>
      </geometry>
      <material name="brown">
        <color rgba="0.65 0.50 0.39 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.5 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>

    <!-- Front wall (positive y) -->
    <visual>
      <origin xyz="0 0.245 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.01 0.2"/>
      </geometry>
      <material name="brown"/>
    </visual>
    <collision>
      <origin xyz="0 0.245 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.01 0.2"/>
      </geometry>
    </collision>

    <!-- Back wall (negative y) -->
    <visual>
      <origin xyz="0 -0.245 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.01 0.2"/>
      </geometry>
      <material name="brown"/>
    </visual>
    <collision>
      <origin xyz="0 -0.245 0.11" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.01 0.2"/>
      </geometry>
    </collision>

    <!-- Left wall (negative x) -->
    <visual>
      <origin xyz="-0.245 0 0.11" rpy="0 0 1.5708"/>
      <geometry>
        <box size="0.5 0.01 0.2"/>
      </geometry>
      <material name="brown"/>
    </visual>
    <collision>
      <origin xyz="-0.245 0 0.11" rpy="0 0 1.5708"/>
      <geometry>
        <box size="0.5 0.01 0.2"/>
      </geometry>
    </collision>

    <!-- Right wall (positive x) -->
    <visual>
      <origin xyz="0.245 0 0.11" rpy="0 0 1.5708"/>
      <geometry>
        <box size="0.5 0.01 0.2"/>
      </geometry>
      <material name="brown"/>
    </visual>
    <collision>
      <origin xyz="0.245 0 0.11" rpy="0 0 1.5708"/>
      <geometry>
        <box size="0.5 0.01 0.2"/>
      </geometry>
    </collision>
  </link>
</robot>

