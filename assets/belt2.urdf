<robot name="belt">

  <!-- Base Link (ground) -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="1 0.5 0.1"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>

  <!-- Belt Link (moves along Y-axis) -->
  <link name="belt">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry>
        <box size="1 0.4 0.02"/>
      </geometry>
      <material name="cyan_black">
        <color rgba="0.1 0.9 0.9 1"/>
      </material>
    </visual>
  </link>

  <!-- Prismatic Joint (allows belt to move along Y) -->
  <joint name="belt_slide_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="belt"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100.0" velocity="10.0" lower="-1.0" upper="1.0"/>
  </joint>

</robot>

