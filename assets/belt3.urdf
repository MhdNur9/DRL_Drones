<robot name="belt">
  <link name="base_link">
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
    <visual>
      <geometry>
        <box size="1 0.5 0.1"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="1 0.5 0.1"/>
      </geometry>
    </collision>
  </link>

  <link name="belt">
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry>
        <box size="1 0.4 0.02"/>
      </geometry>
      <material name="cyan_black">
        <color rgba="0.1 0.9 0.9 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry>
        <box size="1 0.4 0.02"/>
      </geometry>
    </collision>
  </link>

  <joint name="belt_slide_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="belt"/>
    <origin xyz="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="100.0" velocity="10.0" lower="-1.0" upper="1.0"/>
  </joint>
</robot>

